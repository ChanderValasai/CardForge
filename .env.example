# Server Configuration
PORT=3000

# MongoDB Atlas Free M0 Connection String or Local MongoDB
# Format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cardforge?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017/cardforge
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cardforge?retryWrites=true&w=majority"

# JWT Secret for signing authentication tokens
JWT_SECRET="cardforge_jwt_secret_dev_key_12345"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
